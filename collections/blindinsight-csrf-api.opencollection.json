{
  "opencollection": "1.0.0",
  "info": {
    "name": "Blind Insight REST accounts csrf API",
    "version": "10.22.0"
  },
  "items": [
    {
      "info": {
        "name": "csrf",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve a CSRF token",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/csrf/",
            "auth": {
              "type": "apikey",
              "key": "sessionid",
              "value": "{{sessionid}}",
              "placement": "query"
            }
          },
          "docs": "Retrieve a CSRF token."
        }
      ]
    }
  ],
  "bundled": true
}