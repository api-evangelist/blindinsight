{
  "opencollection": "1.0.0",
  "info": {
    "name": "Blind Insight REST accounts requests API",
    "version": "10.22.0"
  },
  "items": [
    {
      "info": {
        "name": "requests",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all requests",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/requests/",
            "params": [
              {
                "name": "created",
                "value": "",
                "type": "query"
              },
              {
                "name": "expires",
                "value": "",
                "type": "query"
              },
              {
                "name": "field_name",
                "value": "",
                "type": "query"
              },
              {
                "name": "fulfilled",
                "value": "",
                "type": "query"
              },
              {
                "name": "id",
                "value": "",
                "type": "query"
              },
              {
                "name": "identity",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page."
              },
              {
                "name": "modified",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "The initial index from which to return the results."
              },
              {
                "name": "received",
                "value": "",
                "type": "query"
              },
              {
                "name": "schema",
                "value": "",
                "type": "query"
              },
              {
                "name": "shared",
                "value": "",
                "type": "query",
                "description": "Whether a request has had keys shared or not."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "sessionid",
              "value": "{{sessionid}}",
              "placement": "query"
            }
          },
          "docs": "List all requests that you have access to."
        },
        {
          "info": {
            "name": "Create a new request",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/requests/",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "sessionid",
              "value": "{{sessionid}}",
              "placement": "query"
            }
          },
          "docs": "Create a new request for keys."
        },
        {
          "info": {
            "name": "Retrieve a single request",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/requests/:id/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "A unique value identifying this request."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "sessionid",
              "value": "{{sessionid}}",
              "placement": "query"
            }
          },
          "docs": "Retrieve a single request by its ID."
        },
        {
          "info": {
            "name": "Update a request",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/requests/:id/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "A unique value identifying this request."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "sessionid",
              "value": "{{sessionid}}",
              "placement": "query"
            }
          },
          "docs": "Update a request by its ID. This completely replaces the object."
        },
        {
          "info": {
            "name": "Partially update a request",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/requests/:id/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "A unique value identifying this request."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "sessionid",
              "value": "{{sessionid}}",
              "placement": "query"
            }
          },
          "docs": "Partially update a request by its ID. This only replaces the specified\nfields."
        },
        {
          "info": {
            "name": "Delete a request",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/requests/:id/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "A unique value identifying this request."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "sessionid",
              "value": "{{sessionid}}",
              "placement": "query"
            }
          },
          "docs": "Delete a request by its ID."
        },
        {
          "info": {
            "name": "Fulfill a single request",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/requests/:request_id/fulfill/",
            "params": [
              {
                "name": "request_id",
                "value": "",
                "type": "path",
                "description": "The request ID to fulfill."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "sessionid",
              "value": "{{sessionid}}",
              "placement": "query"
            }
          },
          "docs": "[Blind Insight Proxy] Fulfill a single request"
        },
        {
          "info": {
            "name": "Fulfill all requests",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/requests/fulfill/",
            "auth": {
              "type": "apikey",
              "key": "sessionid",
              "value": "{{sessionid}}",
              "placement": "query"
            }
          },
          "docs": "[Blind Insight Proxy] Fulfill all requests"
        }
      ]
    }
  ],
  "bundled": true
}