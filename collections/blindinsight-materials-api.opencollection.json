                "description": "The key of the material override to delete."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "sessionid",
              "value": "{{sessionid}}",
              "placement": "query"
            }
          },
          "docs": "[Blind Insight Proxy] Delete a single material override"
