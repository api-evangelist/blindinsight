            ],
            "auth": {
              "type": "apikey",
              "key": "sessionid",
              "value": "{{sessionid}}",
              "placement": "query"
            }
          },
          "docs": "[Blind Insight Proxy] Receive a single material"
        },
        {
          "info": {
            "name": "List all material overrides",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/materials/overrides/",
            "auth": {
              "type": "apikey",
              "key": "sessionid",
              "value": "{{sessionid}}",
              "placement": "query"
            }
          },
          "docs": "[Blind Insight Proxy] List all material overrides"
        },
        {
          "info": {
            "name": "Delete all material overrides",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/materials/overrides/",
            "auth": {
              "type": "apikey",
              "key": "sessionid",
              "value": "{{sessionid}}",
              "placement": "query"
            }
          },
          "docs": "[Blind Insight Proxy] Delete all material overrides"
